EMQX_DASHBOARD__DEFAULT_USERNAME=eeyae8@nottingham.ac.uk 
#can be renamed anything as i havent made an account for this
EMQX_DASHBOARD__DEFAULT_PASSWORD=fortknox123

# Basic MQTT authentication
EMQX_AUTHENTICATION__1__MECHANISM=password_based
EMQX_AUTHENTICATION__1__BACKEND=built_in_database
EMQX_AUTHENTICATION__1__USER_ID_TYPE=username
EMQX_AUTHENTICATION__1__PASSWORD_HASH_ALGORITHM__NAME=sha256

# You can add predefined users here
#EMQX_AUTHENTICATION__1__USER__1__USERNAME=user1
#EMQX_AUTHENTICATION__1__USER__1__PASSWORD=password1

# Disable anonymous authentication
EMQX_ALLOW_ANONYMOUS=false